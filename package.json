{
  "name": "roofhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:secrets": "node tools/scan-secrets.mjs",
    "check:secrets:staged": "node tools/scan-secrets.mjs --staged",
    "typecheck": "tsc --noEmit",
    "supabase:db:reset": "npx supabase db reset --local --no-seed --yes",
    "supabase:types:generate": "npx supabase gen types --local --lang typescript > src/types/database.ts",
    "verify:supabase:drift": "node tools/verify-supabase-drift.mjs",
    "verify:supabase:drift:fresh": "npm run supabase:db:reset && npm run verify:supabase:drift",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "maplibre-gl": "^5.22.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
