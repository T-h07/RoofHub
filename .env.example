# Public client configuration (safe to expose in browser bundles)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side allowlist used when generating auth redirect/callback URLs.
# Include every trusted app origin for local/preview/production.
# Example: AUTH_ALLOWED_ORIGINS=http://localhost:3000,https://roofhub.vercel.app,https://app.roofhub.com
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# Optional compatibility alias used by some tooling/migrations:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Optional server-only direct database connection string for CLI tooling/migrations.
# Never expose DATABASE_URL through NEXT_PUBLIC_* values.
# DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# Server-only secrets (never use NEXT_PUBLIC_ for these):
# SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key> # required for profile hard-delete flow
# GOOGLE_CLIENT_ID=<google-oauth-client-id>
# GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
